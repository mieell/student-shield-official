#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Manila'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = studentshield
database.default.username = root
database.default.password = ""
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (generate with: bin2hex(random_bytes(32)))
#--------------------------------------------------------------------
# encryption.key = hex2bin('YOUR_64_CHAR_HEX_KEY_HERE')

#--------------------------------------------------------------------
# EMAIL SMTP SETUP
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPUser = your-email@gmail.com
email.SMTPPass = "your-app-password-here"
email.SMTPPort = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# ML SERVICE
#--------------------------------------------------------------------
ML_API_URL = http://localhost:8000
ML_API_KEY = your-ml-api-key-here

# Optional server-side Groq fallback/triage for Safe Space vents ONLY (Counselor Triage + Explanation).
# Sends ONLY current vent text (no student name/LRN/ID) to Groq OpenAI-compatible chat/completions API.
# Set GROQ_VENT_FALLBACK_ENABLED = true and provide your GROQ_API_KEY (or set GROQ_API_KEY in HF Space Secrets).
GROQ_VENT_FALLBACK_ENABLED = false
GROQ_API_KEY = ""
GROQ_VENT_MODEL = "openai/gpt-oss-120b"

#--------------------------------------------------------------------
# COUNSELOR CONTACT
#--------------------------------------------------------------------
COUNSELOR_PHONE = "09XXXXXXXXXX"
COUNSELOR_EMAIL = "counselor@example.com"

#--------------------------------------------------------------------
# SMS GATEWAY (SMSGate cloud; credentials stay in the server .env)
#--------------------------------------------------------------------
sms.GatewayUrl = "https://api.sms-gate.app/3rdparty/v1/messages"
sms.GatewayUsername = ""
sms.GatewayPassword = ""
sms.GatewayDeviceId = ""
# SIM slot 1 or 2; leave blank to use the phone's configured default.
sms.GatewaySimNumber = ""
# Keep the phone service running with internet and a working SMS SIM/plan.
# Demo controls: one part/recipient, 20 requests per rolling 24h, 10s spacing.

# SMS is temporarily paused. Set true to restore sending.
SMS_ENABLED = false
