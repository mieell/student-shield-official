#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Manila'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = studentshield
database.default.username = root
database.default.password = ""
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (generate with: bin2hex(random_bytes(32)))
#--------------------------------------------------------------------
# encryption.key = hex2bin('YOUR_64_CHAR_HEX_KEY_HERE')

#--------------------------------------------------------------------
# EMAIL SMTP SETUP
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPUser = your-email@gmail.com
email.SMTPPass = "your-app-password-here"
email.SMTPPort = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# ML SERVICE
#--------------------------------------------------------------------
ML_API_URL = http://localhost:8000
ML_API_KEY = your-ml-api-key-here

# Optional server-side backup for vents ONLY, used after ML failure/invalid output.
# Opt in only after reviewing provider data handling; entry text is sent to Google.
# Choose an available Gemini model supporting generateContent JSON-schema output.
GEMINI_VENT_FALLBACK_ENABLED = false
GEMINI_API_KEY = ""
GEMINI_VENT_MODEL = ""

#--------------------------------------------------------------------
# COUNSELOR CONTACT
#--------------------------------------------------------------------
COUNSELOR_PHONE = "09XXXXXXXXXX"
COUNSELOR_EMAIL = "counselor@example.com"

#--------------------------------------------------------------------
# SMS GATEWAY (local Android phone gateway)
#--------------------------------------------------------------------
sms.GatewayUrl = "http://192.168.1.X:8080/send-sms"
